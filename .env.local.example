# No environment variables or API keys are required.
# All content is hardcoded in src/lib/constants.ts and src/lib/data.ts.
# Forms submit via Next.js API routes (src/app/api/) which forward to
# FormSubmit (https://formsubmit.co) — no API keys needed.
#
# Optional: only set this if you deploy to a custom domain, so absolute
# URLs in metadata/sitemap.xml/robots.txt point to the right place.
NEXT_PUBLIC_SITE_URL=https://kirundaconstructions.vercel.app
